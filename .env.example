# Select: mock, groq, or ollama
AGENT_PROVIDER=mock

# Free hosted development through Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local development through Ollama
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434

# Abort model requests after this many milliseconds
MODEL_TIMEOUT_MS=30000
